# ---- Server ----
PORT=3000
NODE_ENV=development            # set to "production" on your live server
PUBLIC_URL=http://localhost:3000 # your live address, e.g. https://snapqut.com (used for links/images in emails)
# DATA_DIR=./data               # where the SQLite database lives; on Render/Railway point this at a persistent disk

# ---- Admin console (/admin) ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=                  # 10+ characters, use a long random one

# ---- Cashfree (Payment Gateway → Developers → API Keys) ----
# Used when set (takes priority over Razorpay). Webhook URL to add in Cashfree: https://YOUR-DOMAIN/api/webhooks/cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox             # sandbox for testing, production for real payments

# ---- Razorpay (optional alternative) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=         # the secret you type when creating the webhook
# Without Razorpay keys the checkout runs in TEST mode (no real payment) unless NODE_ENV=production.
# ALLOW_TEST_CHECKOUT=1          # force test checkout on even in production (don't leave this on)

# ---- Resend (resend.com → API Keys) ----
RESEND_API_KEY=
# Without a key, emails are saved to the admin outbox instead of being sent.
# UPLOAD_DIR=./public/media/uploads  # blog image uploads; on Render/Railway use a folder on the persistent disk, e.g. /var/data/uploads
# KIT_DIR=./data/kit             # where the uploaded kit .zip is stored (defaults to DATA_DIR/kit, never public)
# KIT_MAX_MB=4096                # largest kit upload allowed

# ---- Cloudflare R2 (kit delivery) ----
# With these set, the kit is stored in a PRIVATE R2 bucket and each buyer gets a 10-minute signed link.
# Without them, the kit is stored on this server instead.
R2_ACCOUNT_ID=                   # Cloudflare dashboard → R2 → Account ID (right-hand side)
R2_ACCESS_KEY_ID=                # R2 → Manage API tokens → Create token (Object Read & Write, this bucket only)
R2_SECRET_ACCESS_KEY=
R2_BUCKET=snapqut-kit
